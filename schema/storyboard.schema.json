{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heritage Short storyboard",
  "type": "object",
  "required": ["title", "language", "style_block", "characters", "music", "voice", "shots", "end_card"],
  "additionalProperties": false,
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "logline": {"type": "string"},
    "language": {"type": "string", "description": "BCP-47 code of the narration, e.g. am"},
    "style_block": {"type": "string", "minLength": 10, "description": "Prepended to every image prompt"},
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z_]+$"},
          "name": {"type": "string"},
          "description": {"type": "string", "minLength": 10}
        }
      }
    },
    "voice": {
      "type": "object",
      "required": ["voice_name", "style"],
      "additionalProperties": false,
      "properties": {
        "voice_name": {"type": "string"},
        "style": {"type": "string"}
      }
    },
    "music": {
      "type": "object",
      "required": ["caption", "bpm", "key", "duration_s", "instrumental", "seed"],
      "additionalProperties": false,
      "properties": {
        "caption": {"type": "string"},
        "bpm": {"type": "integer", "minimum": 40, "maximum": 200},
        "key": {"type": "string"},
        "duration_s": {"type": "integer", "minimum": 30, "maximum": 120},
        "instrumental": {"type": "boolean"},
        "seed": {"type": "integer"},
        "cues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["at_shot", "note"],
            "properties": {"at_shot": {"type": "string"}, "note": {"type": "string"}}
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "reason", "shot_size", "min_duration_s", "image_prompt", "motion_prompt", "camera", "seed", "characters", "narration"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^S[0-9]{2}$"},
          "reason": {"type": "string", "minLength": 10, "description": "Why this shot exists"},
          "shot_size": {"enum": ["extreme_wide", "wide", "medium", "medium_close", "close", "insert"]},
          "min_duration_s": {"type": "number", "minimum": 3, "maximum": 12},
          "image_prompt": {"type": "string", "minLength": 10},
          "motion_prompt": {"type": "string", "minLength": 5, "description": "Motion and camera only, for image-to-video"},
          "camera": {"enum": ["push_in", "pull_out", "pan_left", "pan_right", "static"], "description": "Ken Burns fallback move"},
          "seed": {"type": "integer"},
          "characters": {"type": "array", "items": {"type": "string"}},
          "narration": {
            "type": "object",
            "required": ["text_native", "text_en"],
            "additionalProperties": false,
            "properties": {
              "text_native": {"type": "string", "minLength": 1},
              "text_en": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "end_card": {
      "type": "object",
      "required": ["text", "duration_s"],
      "additionalProperties": false,
      "properties": {"text": {"type": "string"}, "duration_s": {"type": "number", "minimum": 2, "maximum": 5}}
    }
  }
}
